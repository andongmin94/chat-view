# Copy to platform/.env locally; never commit actual application credentials.
CHZZK_CLIENT_ID=
CHZZK_CLIENT_SECRET=

# HTTPS service only (npm run serve); ignored by the local developer probe.
# Register the exact CHATVIEW_ORIGIN + /callback with CHZZK.
CHATVIEW_ORIGIN=https://chatview.example
CHATVIEW_TLS_KEY_FILE=/run/secrets/chatview-tls-key.pem
CHATVIEW_TLS_CERT_FILE=/run/secrets/chatview-tls-cert.pem
CHATVIEW_SESSION_DATABASE=/var/lib/chatview/sessions.sqlite
# Operator-managed raw 32-byte key, kept separately from the database volume.
# Reuse the SAME protected key across restarts; startup never replaces it.
CHATVIEW_PROVIDER_KEY_FILE=/run/secrets/chatview-provider.key
CHATVIEW_BIND_ADDRESS=0.0.0.0
