// Generated from the SAME renderer as the browser preview. No network assets.
#pragma once
namespace chatview {
inline constexpr wchar_t kNativeChatDocument[] = LR"CVHTML(<!doctype html>
<html lang="ko"><head><meta charset="utf-8">
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; script-src 'nonce-@CHATVIEW_NONCE@'; style-src 'unsafe-inline'; base-uri 'none'; form-action 'none'">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>ChatView private chat</title>
<style>
:root{color-scheme:dark;--paper:#18191c;--ink:#e4e7ec;--line:#000;--radius:5px;--shadow:4px 4px 0 var(--line)}
html,body{margin:0;width:100%;height:100%;background:transparent;overflow:hidden;color:var(--ink);font:500 16px/1.5 'Segoe UI','Malgun Gothic',sans-serif}
main{box-sizing:border-box;display:flex;flex-direction:column;height:100%;padding:48px 12px 12px;gap:8px}
#status{margin:0;font-size:12px;font-weight:700;color:var(--ink);background:var(--paper);padding:5px 9px;border:2px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow)}
#messages{box-sizing:border-box;list-style:none;overflow:auto;margin:0;padding:0 6px 5px 0;flex:1;scrollbar-width:thin;scrollbar-color:#62656d transparent}
#jump-latest{align-self:center;flex:none;max-width:100%;padding:6px 15px;border:2px solid var(--line);border-radius:var(--radius);background:var(--ink);color:var(--paper);box-shadow:var(--shadow);font:700 13px 'Segoe UI',sans-serif;cursor:pointer}
#jump-latest:focus-visible{outline:2px solid #fff;outline-offset:2px}
#jump-latest::after{content:" · Ctrl+Alt+Shift+J";font-size:11px;opacity:.8}
#jump-latest[hidden]{display:none}
.chat-readability{display:flex;align-items:center;gap:6px;flex:none;flex-wrap:wrap}
.chat-readability span{font-size:11px;color:#eee}
.chat-readability button{border:2px solid var(--line);border-radius:var(--radius);background:var(--paper);color:var(--ink);padding:3px 8px;box-shadow:3px 3px 0 var(--line);font:700 12px 'Segoe UI',sans-serif;cursor:pointer}
.chat-readability button:hover:not(:disabled),#jump-latest:hover{transform:translate(2px,2px);box-shadow:1px 1px 0 var(--line)}
.chat-readability button:active:not(:disabled),#jump-latest:active{transform:translate(3px,3px);box-shadow:none}
.chat-readability button:disabled{opacity:.45;cursor:not-allowed}
.chat-readability button:focus-visible{outline:2px solid #fff;outline-offset:2px}
.chat-readability button[aria-pressed="true"]{background:var(--ink);color:var(--paper)}
#messages.chat-high-contrast li{background:#000;border:1px solid #fff;color:#fff}
#messages.chat-high-contrast time{color:#f0f0f0}
li{display:flex;gap:8px;flex-wrap:wrap;margin:5px 0 8px;padding:6px 9px;border:2px solid var(--line);border-radius:var(--radius);background:var(--paper);box-shadow:var(--shadow);overflow-wrap:anywhere}
time{font-size:12px;color:#bbb}b{unicode-bidi:plaintext}.content{white-space:pre-wrap;unicode-bidi:plaintext;flex-basis:100%}
.chat-role,.chat-verified{display:inline-block;padding:1px 6px;border:1px solid var(--line);border-radius:3px;background:#303238;color:var(--ink);font-size:.78em;font-weight:700;white-space:nowrap}
.chat-role.streamer{background:var(--ink);color:var(--paper)}
.chat-role.streaming_channel_manager{background:#3c414b}
.chat-role.streaming_chat_manager{background:#45404b}
#messages.chat-high-contrast .chat-role,#messages.chat-high-contrast .chat-verified{background:#000;color:#fff;border-color:#fff}
</style></head><body><main><p id="status" role="status"></p><div class="chat-readability" role="group" aria-label="채팅 글자 크기와 대비"><span>읽기 설정</span><button id="chat-font-smaller" type="button" aria-label="글자 작게">A−</button><button id="chat-font-larger" type="button" aria-label="글자 크게">A+</button><button id="chat-contrast" type="button" aria-pressed="false">강한 대비</button></div><ol id="messages" aria-label="채팅"></ol><button id="jump-latest" type="button" aria-keyshortcuts="Control+Alt+Shift+J" title="잠긴 HUD에서도 Ctrl+Alt+Shift+J" hidden>최신 채팅</button></main>
<script nonce="@CHATVIEW_NONCE@">
@CHATVIEW_RENDERER@
@CHATVIEW_NATIVE_BRIDGE@
const disconnectNativeChat = connectNativeChat(document, window.chrome.webview, renderChat, '@CHATVIEW_NONCE@');
addEventListener('pagehide', disconnectNativeChat, {once:true});
</script></body></html>)CVHTML";
}
