// Generated from the SAME renderer as the browser preview. No network assets.
#pragma once
namespace chatview {
inline constexpr wchar_t kNativeChatDocument[] = LR"CVHTML(<!doctype html>
<html lang="ko"><head><meta charset="utf-8">
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; script-src 'nonce-@CHATVIEW_NONCE@'; style-src 'unsafe-inline'; base-uri 'none'; form-action 'none'">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>ChatView private chat</title>
<style>
html,body{margin:0;width:100%;height:100%;background:transparent;overflow:hidden;color:#fff;font:16px/1.5 'Segoe UI',sans-serif}
main{box-sizing:border-box;display:flex;flex-direction:column;height:100%;padding:48px 12px 12px;gap:8px}
#status{margin:0;font-size:12px;color:#ddd;background:rgba(20,20,24,.75);padding:6px 10px;border-radius:8px}
#messages{list-style:none;overflow:auto;margin:0;padding:0;flex:1}
#jump-latest{align-self:center;flex:none;padding:7px 16px;border:1px solid rgba(145,241,213,.7);border-radius:999px;background:rgba(28,92,74,.94);color:#fff;font:13px 'Segoe UI',sans-serif;cursor:pointer}
#jump-latest:focus-visible{outline:2px solid #a6f5d8;outline-offset:2px}
#jump-latest[hidden]{display:none}
.chat-readability{display:flex;align-items:center;gap:6px;flex:none;flex-wrap:wrap}
.chat-readability span{font-size:11px;color:#eee}
.chat-readability button{border:1px solid rgba(230,242,255,.6);border-radius:6px;background:rgba(20,20,24,.9);color:#fff;padding:4px 9px;font:12px 'Segoe UI',sans-serif;cursor:pointer}
.chat-readability button:disabled{opacity:.45;cursor:not-allowed}
.chat-readability button:focus-visible{outline:2px solid #a6f5d8;outline-offset:2px}
.chat-readability button[aria-pressed="true"]{border-color:#a6f5d8}
#messages.chat-high-contrast li{background:#000;border:1px solid #fff;color:#fff}
#messages.chat-high-contrast time{color:#f0f0f0}
li{display:flex;gap:8px;flex-wrap:wrap;margin:5px 0;padding:7px 10px;border-radius:8px;background:rgba(20,20,24,.78);overflow-wrap:anywhere}
time{font-size:12px;color:#bbb}b{unicode-bidi:plaintext}.content{white-space:pre-wrap;unicode-bidi:plaintext;flex-basis:100%}
.chat-role,.chat-verified{display:inline-block;padding:1px 6px;border:1px solid rgba(200,235,240,.85);border-radius:5px;background:rgba(24,69,74,.95);color:#e4f9ff;font-size:.78em;font-weight:650;white-space:nowrap}
.chat-role.streamer{background:rgba(107,71,20,.97);color:#fff1cf;border-color:#e3bc70}
.chat-role.streaming_channel_manager{background:rgba(35,80,111,.97)}
.chat-role.streaming_chat_manager{background:rgba(76,54,112,.97)}
#messages.chat-high-contrast .chat-role,#messages.chat-high-contrast .chat-verified{background:#000;color:#fff;border-color:#fff}
</style></head><body><main><p id="status" role="status"></p><div class="chat-readability" role="group" aria-label="채팅 글자 크기와 대비"><span>읽기 설정</span><button id="chat-font-smaller" type="button" aria-label="글자 작게">A−</button><button id="chat-font-larger" type="button" aria-label="글자 크게">A+</button><button id="chat-contrast" type="button" aria-pressed="false">강한 대비</button></div><ol id="messages" aria-label="채팅"></ol><button id="jump-latest" type="button" hidden>최신 채팅</button></main>
<script type="module" nonce="@CHATVIEW_NONCE@">
@CHATVIEW_RENDERER@
@CHATVIEW_NATIVE_BRIDGE@
const disconnectNativeChat = connectNativeChat(document, window.chrome.webview, renderChat, '@CHATVIEW_NONCE@');
addEventListener('pagehide', disconnectNativeChat, {once:true});
</script></body></html>)CVHTML";
}
