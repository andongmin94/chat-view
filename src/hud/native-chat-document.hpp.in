// Generated from the SAME renderer as the browser preview. No network assets.
#pragma once
namespace chatview {
inline constexpr wchar_t kNativeChatDocument[] = LR"CVHTML(<!doctype html>
<html lang="ko"><head><meta charset="utf-8">
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; script-src 'nonce-@CHATVIEW_NONCE@'; style-src 'unsafe-inline'; font-src 'self'; base-uri 'none'; form-action 'none'">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>ChatView private chat</title>
<style>
@font-face{font-family:'Pretendard Variable';font-style:normal;font-weight:100 900;font-display:swap;src:url('/fonts/PretendardVariable.woff2') format('woff2')}
:root{color-scheme:light;--canvas:#f4f5f7;--paper:#fff;--primary:#27282b;--ink:#000;--line:#000;--radius:5px;--shadow:4px 4px 0 var(--line)}
html,body{margin:0;width:100%;height:100%;background:transparent;overflow:hidden;color:var(--ink);font:500 16px/1.55 'Pretendard Variable','Pretendard',sans-serif}
main{box-sizing:border-box;display:flex;flex-direction:column;height:100%;padding:48px 12px 12px;gap:8px}
#status{margin:0;font-size:14px;line-height:20px;font-weight:500;color:var(--ink);background:var(--canvas);padding:8px 12px;border:2px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow)}
#messages{box-sizing:border-box;list-style:none;overflow:auto;margin:0;padding:0 6px 5px 0;flex:1;scrollbar-width:thin;scrollbar-color:#62656d transparent}
button{--button-shadow:var(--shadow);display:inline-flex;align-items:center;justify-content:center;gap:8px;box-sizing:border-box;border:2px solid var(--line);border-radius:var(--radius);box-shadow:var(--button-shadow);font-family:'Pretendard Variable','Pretendard',sans-serif;font-weight:500;cursor:pointer;transition:transform 140ms ease,box-shadow 140ms ease}
#jump-latest{align-self:center;flex:none;height:36px;max-width:100%;padding:0 12px;background:var(--primary);color:var(--canvas);font-size:14px;line-height:20px;white-space:nowrap}
#jump-latest::after{content:" · Ctrl+Alt+Shift+J";font-size:12px}
#jump-latest[hidden]{display:none}
.chat-readability{display:flex;align-items:center;gap:6px;flex:none;flex-wrap:wrap}
.chat-readability span{font-size:14px;line-height:20px;padding:4px 8px;border:2px solid var(--line);border-radius:var(--radius);background:var(--canvas)}
.chat-readability button{height:28px;padding:0 8px;background:var(--canvas);color:var(--ink);font-size:12px;line-height:16px}
button:hover:not(:disabled){--button-shadow:1px 1px 0 var(--line);transform:translate(3px,3px)}
button:active:not(:disabled){--button-shadow:0 0 0 var(--line);transform:translate(4px,4px)}
button:disabled{opacity:.5;pointer-events:none}
button:focus-visible{outline:none;box-shadow:0 0 0 1px var(--ink),var(--button-shadow)}
.chat-readability button[aria-pressed="true"]{background:var(--primary);color:var(--canvas)}
#messages.chat-high-contrast li{background:#000;border-color:#fff;color:#fff}
#messages.chat-high-contrast time{color:#f0f0f0}
li{display:flex;gap:8px;flex-wrap:wrap;margin:0 0 12px;padding:24px;border:2px solid var(--line);border-radius:var(--radius);background:var(--canvas);box-shadow:var(--shadow);overflow-wrap:anywhere}
time{font-size:12px;line-height:16px;color:#565a63}b{unicode-bidi:plaintext;font-weight:700}.content{white-space:pre-wrap;unicode-bidi:plaintext;flex-basis:100%}
.chat-role,.chat-verified{display:inline-block;padding:4px 8px;border:2px solid var(--line);border-radius:var(--radius);background:var(--canvas);color:var(--ink);font-size:12px;line-height:16px;font-weight:500;white-space:nowrap}
.chat-role.streamer{background:var(--primary);color:var(--canvas)}
#messages.chat-high-contrast .chat-role,#messages.chat-high-contrast .chat-verified{background:#000;color:#fff;border-color:#fff}
@media(max-width:420px){#jump-latest::after{display:none}}
@media(prefers-reduced-motion:reduce){button{transition:none}}
</style></head><body><main><p id="status" role="status"></p><div class="chat-readability" role="group" aria-label="채팅 글자 크기와 대비"><span>읽기 설정</span><button id="chat-font-smaller" type="button" aria-label="글자 작게">A−</button><button id="chat-font-larger" type="button" aria-label="글자 크게">A+</button><button id="chat-contrast" type="button" aria-pressed="false">강한 대비</button></div><ol id="messages" aria-label="채팅"></ol><button id="jump-latest" type="button" aria-keyshortcuts="Control+Alt+Shift+J" title="잠긴 HUD에서도 Ctrl+Alt+Shift+J" hidden>최신 채팅</button></main>
<script nonce="@CHATVIEW_NONCE@">
@CHATVIEW_RENDERER@
@CHATVIEW_NATIVE_BRIDGE@
const disconnectNativeChat = connectNativeChat(document, window.chrome.webview, renderChat, '@CHATVIEW_NONCE@');
addEventListener('pagehide', disconnectNativeChat, {once:true});
</script></body></html>)CVHTML";
}
